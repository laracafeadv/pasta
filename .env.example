# ─── Supabase (Project Settings → API) ─────────────────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sb_publishable_sua_chave_publica
# Chave secreta (service role). NUNCA exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_sua_chave_secreta

# ─── Endereço público do CRM ───────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://crm.laracafe.com.br

# ─── OpenAI (assistente e base de conhecimento) ────────────────────────────
OPENAI_API_KEY=sk-proj-sua-chave
# Modelo usado nas respostas do WhatsApp (opcional)
OPENAI_MODEL=gpt-4.1-mini
# Modelo de transcrição dos áudios do WhatsApp (opcional)
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ─── WhatsApp Cloud API (Meta for Developers → seu app → WhatsApp) ─────────
WHATSAPP_TOKEN=token-permanente-do-usuario-do-sistema
WHATSAPP_PHONE_NUMBER_ID=id-do-numero-do-escritorio
# Uma senha que você inventa e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=invente-uma-frase-longa
# App Secret (Configurações do app → Básico). Obrigatório em produção.
WHATSAPP_APP_SECRET=segredo-do-app
# Segundos de espera antes de responder (junta mensagens seguidas), em ms (opcional)
WHATSAPP_ESPERA_MS=6000

# ─── Google Drive (repositório de documentos; conta de serviço) ───────────
# E-mail e chave privada da conta de serviço (JSON baixado no Google Cloud).
GOOGLE_SERVICE_ACCOUNT_EMAIL=crm-lara@seu-projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID da pasta "Clientes" dentro do Drive compartilhado do escritório
GOOGLE_DRIVE_PASTA_CLIENTES=1AbCdEf...

# ─── Lembretes de prazos (agendador externo chama /api/cron/lembretes) ─────
CRON_SECRET=troque-por-um-segredo-longo

# ─── E-mail de convite da equipe (Resend, opcional) ────────────────────────
RESEND_API_KEY=re_sua_chave
MAILER_SENDER_EMAIL=CRM Lara Café <crm@laracafe.com.br>

# ─── Google (login do usuário: Gmail somente leitura e Agenda, usados pela Secretária) ───
# Google Cloud Console → Credenciais → ID do cliente OAuth (aplicativo da Web). Ative as APIs Gmail e Google Calendar.
# URI de redirecionamento autorizado: <NUXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=id-do-cliente.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=segredo-do-cliente
# Só se o endereço de retorno for diferente do padrão acima (opcional)
GOOGLE_REDIRECT_URI=
